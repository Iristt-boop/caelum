[Unit]
Description=FSR402 Touch Data Receiver
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/touch-server
ExecStart=/usr/bin/python3 /root/touch-server/touch_server.py
Restart=always
RestartSec=3
Environment=TOUCH_PORT=9333
Environment=TOUCH_DATA_DIR=/root/touch-server/data
# Environment=TOUCH_TOKEN=你的随机暗号

[Install]
WantedBy=multi-user.target
