# ⚠️ 这份是**模板**，不是线上那份（2026-09-11 改）。
#
# 原来这里明文写着五个 24 字节的真实路径暗号（ombre / tracker / toy-mcp /
# ha-mcp / touch），而这个文件是**被 git 跟踪的**。那五个服务的应用层全是零鉴权，
# 唯一门禁就是这段路径 —— 也就是说"能读仓库"等于"能连全部 MCP"。
#
# 现在真实值只存在于线上 /etc/caddy/Caddyfile，用 Caddy 的 env 占位符注入：
#     {$TOKEN_OMBRE} {$TOKEN_TRACKER} {$TOKEN_TOY} {$TOKEN_HA} {$TOKEN_TOUCH}
# 部署时由 /etc/systemd/system/caddy.service.d/tokens.conf 提供（655 权限、只 root 可读）：
#     Environment=TOKEN_OMBRE=...
# 详见修复排期 0.5 / 0.7。**暗号本身必须轮换过一次** —— 旧值已经在 git 历史里了。
noxtang.com {
    handle_path /ombre/REPLACE_ME_OMBRE/* {
        reverse_proxy localhost:8002
    }
    handle_path /tracker/REPLACE_ME_TRACKER/* {
        reverse_proxy localhost:8000
    }
    handle_path /toy-mcp/REPLACE_ME_TOY/* {
        reverse_proxy localhost:8003
    }
    handle_path /ha-mcp/REPLACE_ME_HA/* {
        reverse_proxy localhost:8004
    }
    handle_path /touch/REPLACE_ME_TOUCH/* {
        reverse_proxy localhost:9336
    }
    # 健康数据接收（iPhone 快捷指令 POST 进来）。
    # 用 handle 不用 handle_path —— handle_path 会把 /health 前缀剥掉，
    # 而后端的路由就叫 /health/sync，剥了就 404。
    handle /health/* {
        reverse_proxy localhost:8102
    }
    # MCP 客户端连接前会探测这两个路径判断「要不要登录」。
    # 不挡的话它们会落到下面的 catch-all，bridge 对未知路径返回前端 HTML，
    # 客户端拿 200+HTML 去当 JSON 解析 → 报「无法注册 sign-in service」。
    # 返回 404 才是「这里不需要 OAuth，直接连」的正确答复。
    # ⚠️ 只挡 oauth-*，/.well-known/acme-challenge/ 是续证书用的，不能挡。
    handle /.well-known/oauth-authorization-server* {
        respond 404
    }
    handle /.well-known/oauth-protected-resource* {
        respond 404
    }


    handle {
        reverse_proxy localhost:3003
    }
}

reading.noxtang.com {
    reverse_proxy localhost:3100
}
# 2026-08-01 迁移时新增。老机上 Home Assistant 的 8123 是直接暴露在公网的，
# 明文 HTTP、没有 TLS。糖糖在外面要用，所以改成走 Caddy，证书自动签。
# 防火墙里 8123 不再放行。
ha.noxtang.com {
    reverse_proxy localhost:8123
}

# eryu music player
music.noxtang.com {
    reverse_proxy localhost:9090
}

# netease-music-mcp
netease-mcp.noxtang.com {
    reverse_proxy localhost:3456
}
