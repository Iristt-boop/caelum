[Unit]
Description=Touch MCP (共感娃娃触摸记录查询)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/touch-mcp
ExecStart=/usr/bin/python3 /root/touch-mcp/server.py
Restart=always
RestartSec=5
Environment=PYTHONUTF8=1
Environment=TOUCH_TRANSPORT=streamable-http
Environment=TOUCH_PORT=9336
Environment=TOUCH_DATA_FILE=/root/touch-server/data/touch_moments.jsonl

[Install]
WantedBy=multi-user.target
