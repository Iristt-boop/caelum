/* ---------- 暖桃色 warm · App 遗产主题 ----------
   由原 themes.js derive() 最终值原样转写，观感与改造前一致。 */
[data-theme="warm"] {
  --bg-base: #F4F2EE;
  --rail: rgba(250, 249, 247, 0.8);
  --panel: rgba(250, 249, 247, 0.62);
  --panel-2: rgba(250, 249, 247, 0.4);
  --line: rgba(35,34,32,0.06);
  --text-1: #232220;
  --text-2: #81807d;
  --text-3: #969491;
  --accent: #BF562F;
  --accent-2: #D48A6A;
  --accent-soft: rgba(191, 86, 47, 0.15);
  --shadow: 0 14px 34px -16px rgba(40, 30, 20, 0.22);
  --glow-a: rgba(191, 86, 47, 0.32);
  --glow-b: rgba(212, 138, 106, 0.26);
  --glow-c: rgba(150, 148, 145, 0.22);

  /* 卡片/面板的不透明底：沿用原 --color-card 值 */
  --surface: #faf9f7;

  /* ---- App 过渡别名桥（未迁移页面靠它认新令牌；全迁完后删除）---- */
  --color-accent: var(--accent);
  --color-accent-light: #d99a82;
  --color-accent-bg: #c56946;
  --color-accent-text: #a13811;
  --color-bg: var(--bg-base);
  --color-card: var(--surface);
  --color-bubble-ai: var(--panel-2);
  --color-text-primary: var(--text-1);
  --color-text-body: var(--text-1);
  --color-text-secondary: var(--text-2);
  --color-text-muted: var(--text-3);
  --color-text-subtle: var(--text-3);
  --color-text-dark: var(--text-2);
  --color-border: var(--line);
  --color-border-light: var(--line);
  --color-dark-btn: #232220;
  --color-success: #D48A6A;
  --color-danger: #C2654E;
}

