# 复制成 .env 填上真值。.env 已在 .gitignore 里，不会进 git。
#
# 默认走 OpenRouter：一个 key 通吃所有模型，随时换。
OPENROUTER_API_KEY=

# 想换模型改这里就行，代码不用动
NOX_PRIMARY_MODEL=anthropic/claude-sonnet-4.5

# ---------------------------------------------------------------------------
# 想要 Anthropic 原生能力（1 小时缓存、adaptive thinking），换成这三行：
#
# NOX_PRIMARY_PROVIDER=anthropic
# NOX_PRIMARY_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=sk-ant-...
#
# 差别：OpenRouter 的缓存只有 5 分钟档，对断续聊天基本等于没有；
# Anthropic 直连可以用 1 小时档，那 11.5K 的核心准则一个月能省几十刀。
# ---------------------------------------------------------------------------

# Ombre Brain（MCP over streamable-http）
# 本地开发走公网，部署到 VPS 后改成 http://127.0.0.1:8002/mcp
NOX_OB_URL=https://noxtang.com/ombre/mcp

# 杂活模型：意图分类、记忆整理这类，派给便宜的，不占主线缓存
NOX_UTILITY_PROVIDER=openai_compat
NOX_UTILITY_MODEL=deepseek/deepseek-chat
NOX_UTILITY_BASE_URL=https://openrouter.ai/api/v1

# 循环硬上限
NOX_MAX_ITERATIONS=12

# 服务监听
NOX_HOST=127.0.0.1
NOX_PORT=8100
